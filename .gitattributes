# Always commit these with LF line endings — they're piped to `sh` from CF Pages
# and CRLF would break the shebang / heredocs.
*.sh   text eol=lf
*.ps1  text eol=lf
_redirects text eol=lf
_headers   text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Binary-safe sentinels
*.png binary
*.jpg binary

# The update feed is SIGNED OVER EXACT BYTES (ed25519 detached, see README).
# Any line-ending conversion between signing and serving silently invalidates
# the signature — treat feed files as byte-exact, never converted.
feed/*.json -text
feed/*.sig  -text
*.mjs text eol=lf
